{
  "name": "unity-controller",
  "displayName": "Unity Controller",
  "version": "0.2.0",
  "description": "Read scene, asset, script, component, rendering, physics, package and API information from an external Unity MCP server. Fixed target instance; write operations and code execution are blocked.",
  "icon": "icon.svg",
  "engines": {
    "cage": ">=0.2.0"
  },
  "kind": "host",
  "permissions": [
    "network",
    "files"
  ],
  "categories": [
    "developer",
    "desktop"
  ],
  "contributes": {
    "mcpServers": [
      {
        "id": "unity",
        "command": [
          "python",
          "-u",
          "server.py"
        ]
      }
    ],
    "settings": [
      {
        "id": "url",
        "title": "Unity MCP URL",
        "type": "string",
        "env": "UNITY_CONTROLLER_URL",
        "default": "http://127.0.0.1:8083/mcp",
        "required": true
      },
      {
        "id": "instance",
        "title": "Unity instance (Name@hash)",
        "description": "Use unity_controller_instances to obtain Name@hash. Required for project queries; leave empty only to list instances.",
        "type": "string",
        "env": "UNITY_CONTROLLER_INSTANCE",
        "required": false
      },
      {
        "id": "token",
        "title": "Bearer token (optional)",
        "type": "secret",
        "env": "UNITY_CONTROLLER_TOKEN"
      }
    ]
  }
}
